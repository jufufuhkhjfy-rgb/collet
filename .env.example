# このファイルを .env にコピーして値を入れてください。.env は誰にも見せないこと。

# 楽天ウェブサービス（https://webservice.rakuten.co.jp/app/list）の「アプリケーションID」と「アクセスキー」
RAKUTEN_APP_ID=
RAKUTEN_ACCESS_KEY=
# 同じ画面の「アフィリエイトID」（任意）
RAKUTEN_AFFILIATE_ID=

# 紹介文を書くときの、投稿者の紹介（任意）。例: 一人暮らしの社会人で、北欧インテリアが好きな人
COLLET_PERSONA=

# 紹介文をAIで書くときの Claude API キー（任意。なければPCのAI「Ollama」かテンプレートで作ります）
ANTHROPIC_API_KEY=
